# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is git-ignored — NEVER commit it.
# Secrets should NEVER appear in version control. Consider using
# environment variables (TF_VAR_anthropic_api_key) or a secrets
# manager (AWS Secrets Manager, HashiCorp Vault) instead.

aws_region   = "us-east-1"
project_name = "rag-platform"
environment  = "prod"

# Name of an existing EC2 key pair in your AWS account.
# Create one: aws ec2 create-key-pair --key-name rag-platform-prod --query 'KeyMaterial' --output text > rag-platform-prod.pem
# Store the .pem file OUTSIDE the project directory (e.g. ~/.ssh/).
key_pair_name = "your-key-pair-name"

# Restrict SSH to your own IP — never use 0.0.0.0/0 in production.
# Find your IP: curl -s https://checkip.amazonaws.com
allowed_ssh_cidr = "YOUR_IP/32"

# Instance types
instance_type_weaviate       = "t3.medium"
instance_type_api            = "t3.small"
weaviate_data_volume_size_gb = 20
weaviate_version             = "1.27.0"

# --- Secrets (required) ---
# Alternatively, set via env: export TF_VAR_anthropic_api_key="sk-ant-..."
anthropic_api_key = "sk-ant-..."
openai_api_key    = "sk-proj-..."
github_token      = "ghp_..."

# Deployment source and benchmark-safe runtime defaults.
github_ref       = "main"

route53_zone_name = "example.com"
rag_domain_name   = "rag.example.com"

approved_source_ids = ["opsdesk-demo-runbook"]
embed_backend      = "openai"
embed_model_local  = "BAAI/bge-small-en-v1.5"
embed_dimensions   = 1536 # use 384 with bge-small-en-v1.5
cache_backend      = "memory"
api_rate_limit     = "1000/minute"
api_workers        = 1
