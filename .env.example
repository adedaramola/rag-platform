# RAG Platform — environment configuration
# Copy to .env and fill in your values:  cp .env.example .env
# .env is git-ignored — NEVER commit it.

# --- Required ---
RAG_PLATFORM_ANTHROPIC_API_KEY=sk-ant-...

# --- Embedding backend ---
# "openai" (default, requires RAG_PLATFORM_OPENAI_API_KEY) or "local" (requires pip install 'rag-platform[local-embed]')
RAG_PLATFORM_EMBED_BACKEND=local
# RAG_PLATFORM_OPENAI_API_KEY=sk-proj-...

# --- Retrieval tuning ---
RAG_PLATFORM_TOP_K_DENSE=30
RAG_PLATFORM_TOP_K_RERANK=8

# --- Eval judge ---
# Local Ollama judge (zero API cost). Requires `ollama pull <model>` first.
RAG_PLATFORM_EVAL_JUDGE_MODEL=gemma2:9b

# --- Optional: Langfuse tracing (pip install 'rag-platform[observability]') ---
# RAG_PLATFORM_LANGFUSE_PUBLIC_KEY=pk-lf-...
# RAG_PLATFORM_LANGFUSE_SECRET_KEY=sk-lf-...
# RAG_PLATFORM_LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional: Semantic cache ---
# RAG_PLATFORM_CACHE_BACKEND=none          # "none" | "memory" | "redis"
# RAG_PLATFORM_REDIS_URL=redis://localhost:6379

# --- Optional: API authentication and OpsDesk retrieval ---
# When set, /query and /metrics require X-API-Key. /v1/search always requires it.
# RAG_PLATFORM_API_KEY=your-secret-api-key
# JSON array of stable IDs derived from approved filenames (for example vpn-runbook.pdf).
# /v1/search is unavailable until at least one approved source is configured.
# RAG_PLATFORM_APPROVED_SOURCE_IDS=["vpn-runbook"]
# RAG_PLATFORM_SEARCH_MAX_EXCERPT_CHARS=1200
