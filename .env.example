# Stratum RAG — environment configuration
# Copy to .env and fill in your values:  cp .env.example .env
# .env is git-ignored — NEVER commit it.

# --- Required ---
STRATUM_ANTHROPIC_API_KEY=sk-ant-...

# --- Embedding backend ---
# "openai" (default, requires STRATUM_OPENAI_API_KEY) or "local" (requires pip install 'stratum[local-embed]')
STRATUM_EMBED_BACKEND=local
# STRATUM_OPENAI_API_KEY=sk-proj-...

# --- Retrieval tuning ---
STRATUM_TOP_K_DENSE=30
STRATUM_TOP_K_RERANK=8

# --- Eval judge ---
# Local Ollama judge (zero API cost). Requires `ollama pull <model>` first.
STRATUM_EVAL_JUDGE_MODEL=gemma2:9b

# --- Optional: Langfuse tracing (pip install 'stratum[observability]') ---
# STRATUM_LANGFUSE_PUBLIC_KEY=pk-lf-...
# STRATUM_LANGFUSE_SECRET_KEY=sk-lf-...
# STRATUM_LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional: Semantic cache ---
# STRATUM_CACHE_BACKEND=none          # "none" | "memory" | "redis"
# STRATUM_REDIS_URL=redis://localhost:6379

# --- Optional: API authentication ---
# When set, /query and /metrics require X-API-Key header.
# STRATUM_API_KEY=your-secret-api-key
